# ---------------------------------------------------------------------------
# OfferShield environment configuration
# Copy this file to ".env" and adjust values. NEVER commit your real .env.
# Every value below is optional. OfferShield runs fully without paid APIs.
# ---------------------------------------------------------------------------

# Flask session secret. If unset, a random value is generated at startup.
SECRET_KEY=change-me-to-a-long-random-string

# Upload limits (megabytes) and pasted text limit (characters)
MAX_UPLOAD_MB=5
MAX_TEXT_CHARS=50000

# How long completed case reports are kept before automatic deletion (hours)
CASE_TTL_HOURS=24

# How long hashed document similarity signatures are retained (days)
DOC_INDEX_TTL_DAYS=90

# Network checks (domain/DNS/SSL/RDAP/reputation). Set to 0 for offline demos.
NETWORK_CHECKS_ENABLED=1
DOMAIN_TIMEOUT=6

# ---------------------------------------------------------------------------
# OPTIONAL AI EXPLANATION (OpenAI-compatible chat completions endpoint)
# The rule engine produces the score. AI only explains findings.
# Leave AI_API_KEY empty to disable AI entirely.
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30

# ---------------------------------------------------------------------------
# OPTIONAL URL REPUTATION SERVICES
# ---------------------------------------------------------------------------
# VirusTotal v3 API key (url report lookup)
VIRUSTOTAL_API_KEY=
# Google Safe Browsing v4 API key
SAFE_BROWSING_API_KEY=

# Optional custom RDAP endpoint. {domain} is substituted.
# Default uses the public rdap.org bootstrap service.
RDAP_URL_TEMPLATE=https://rdap.org/domain/{domain}
